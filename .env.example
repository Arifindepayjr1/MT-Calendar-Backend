PORT=3000

# Postgres connection. The bundled docker-compose.yml exposes 5433 on host.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=traderlog
DB_PASSWORD=traderlog
DB_NAME=traderlog
DB_SYNCHRONIZE=true

# Change this before deploying.
JWT_SECRET=change-me-to-a-long-random-value
JWT_EXPIRES_IN=7d

# Gmail OTP delivery. Create a 16-character App Password in Google Account →
# Security → 2-Step Verification → App passwords, then paste it here.
# SMTP_APP_PASSWORD=your-16-character-app-password
SMTP_USER=arifindepayjr@gmail.com
SMTP_APP_PASSWORD=
SMTP_FROM=TradeLog <arifindepayjr@gmail.com>

# Fallback only: when SMTP_APP_PASSWORD is empty, development echoes the code
# as `devCode` so the OTP screen remains testable. Never enable in production.
AUTH_DEV_CODE=true

# Optional: internal read-only MT5 history worker.
# NestJS is the only HTTP API. The Python worker is spawned over stdio and is
# never exposed on a network port. Use Python 3.12 for the official MT5 wheel.
# MT5_PYTHON=C:\Users\DELL\Desktop\aa\TraderLog\trader_log\backend\.venv\Scripts\python.exe
# MT5_WORKER_PATH=C:\Users\DELL\Desktop\aa\TraderLog\trader_log\backend\mt5_worker.py
# MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_REQUEST_TIMEOUT_MS=30000
MT5_CACHE_TTL_SECONDS=60
MT5_SESSION_GAP_MULTIPLIER=3
MT5_MAX_SESSION_HOURS=30
MT5_MAX_REQUEST_BARS=5000
MT5_MAX_SYMBOLS=5000
