meta {
  name: Request code
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/request-code
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}",
    "name": "{{name}}",
    "framework": "{{framework}}"
  }
}

script:post-response {
  const data = res.getBody();
  if (data && data.devCode) {
    bru.setEnvVar('otp', data.devCode);
  }
}

docs {
  200 with expiresInSeconds (600). With SMTP_APP_PASSWORD set, the code is
  emailed to `email`, delivery is "email" and no code is returned. Without it,
  development returns delivery "dev" plus `devCode`, saved to local `otp`.
}
